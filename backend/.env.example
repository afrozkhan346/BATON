# Server Configuration
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Configuration
# Options: gemini | groq | mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Database Configuration
# Set SUPABASE_URL and SUPABASE_KEY to use Supabase PostgreSQL.
# If omitted, BATON defaults to a local SQLite database for offline development/testing.
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=sqlite:///./baton_dev.db
